#include <stdio.h>

int main()
{
    char name[50];
    int roll;
    int m1, m2, m3;
    int total;
    float average;

    printf("===== STUDENT GRADE TRACKER =====\n");

    printf("Enter Student Name: ");
    scanf(" %[^\n]", name);

    printf("Enter Roll Number: ");
    scanf("%d", &roll);

    printf("Enter Marks of Subject 1: ");
    scanf("%d", &m1);

    printf("Enter Marks of Subject 2: ");
    scanf("%d", &m2);

    printf("Enter Marks of Subject 3: ");
    scanf("%d", &m3);

    total = m1 + m2 + m3;
    average = total / 3.0;

    printf("\n===== STUDENT REPORT =====\n");
    printf("Name : %s\n", name);
    printf("Roll No : %d\n", roll);
    printf("Total : %d\n", total);
    printf("Average : %.2f\n", average);

    if(average >= 90)
        printf("Grade : A");
    else if(average >= 80)
        printf("Grade : B");
    else if(average >= 70)
        printf("Grade : C");
    else if(average >= 60)
        printf("Grade : D");
    else
        printf("Grade : F");

    return 0;
}